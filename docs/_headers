/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://apps.lightmorphic.com; connect-src 'self' https://apps.lightmorphic.com; img-src 'self' https://apps.lightmorphic.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

# The stylesheet and the script are tiny and have no fingerprint in their
# names, so a day-long cache meant a change could take a day to show up. They
# are revalidated on every visit instead, which costs a 304 and nothing else.
# The link in each page also carries a ?v= stamp holding a hash of the file;
# tools/stamp-assets.py sets it, so run that after editing either one.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/images/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
